# Homzy Admin Configuration
# Copy this file to .env and fill in your actual API keys

# AI Provider API Keys (Owner Configurable)
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here

# Default AI Provider (openai, claude, gemini)
DEFAULT_AI_PROVIDER=openai

# Google Calendar API (OAuth)
GOOGLE_CALENDAR_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_oauth_client_secret

# Payment Gateway Keys
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# App Configuration
SERVICE_RADIUS_MILES=15
EMERGENCY_SURCHARGE_ENABLED=true
EMERGENCY_SURCHARGE_PERCENTAGE=50
PLATFORM_COMMISSION_PERCENTAGE=20

# Pricing Model (platform_defined or provider_defined)
PRICING_MODEL=platform_defined
